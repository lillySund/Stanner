@page
@model Stanner.Pages.Notes.DeleteModel
@{
    ViewData["Title"] = "Delete Note";
}

<div class="container">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <h1 class="text-danger">Delete Note</h1>
            <hr />
            
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle"></i>
                <strong>Warning!</strong> Are you sure you want to delete this note? This action cannot be undone.
            </div>
            
            <div class="card">
                <div class="card-body">
                    <h3>@Model.Note.Title</h3>
                    <p class="text-muted">
                        <i class="bi bi-calendar"></i> @Model.Note.CreatedAt.ToString("MMM dd, yyyy")
                    </p>
                    <p>@Model.Note.Content</p>
                </div>
            </div>
            
            <form method="post" class="mt-3">
                <input type="hidden" asp-for="Note.Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Delete Note
                </button>
                <a asp-page="/Notes/Index" asp-route-subjectId="@Model.Note.SubjectId" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>